{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "What the main window may do: listen to the events the Rust side emits and call the three B1 commands.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-daemon-view",
    "allow-daemon-retry",
    "allow-app-info",
    "allow-ui-state-get",
    "allow-ui-state-set",
    "allow-announce",
    "allow-profiles-list",
    "allow-profile-get",
    "allow-profile-update",
    "allow-profile-validate-raw",
    "allow-profile-duplicate",
    "allow-profile-export",
    "allow-profile-delete",
    "allow-group-create",
    "allow-group-rename",
    "allow-group-delete",
    "allow-groups-reorder"
  ]
}
