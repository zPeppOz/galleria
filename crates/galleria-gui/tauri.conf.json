{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Galleria",
  "identifier": "io.github.zpeppoz.galleria",
  "build": {
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Galleria",
        "visible": false,
        "width": 1180,
        "height": 740
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "fileAssociations": [
      {
        "ext": ["ovpn"],
        "mimeType": "application/x-openvpn-profile",
        "name": "OpenVPN profile",
        "description": "OpenVPN profile"
      }
    ]
  }
}
