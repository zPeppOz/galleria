{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Galleria Spike",
  "version": "0.0.1",
  "identifier": "it.galleria.spike",
  "build": { "frontendDist": "../dist" },
  "app": { "windows": [], "security": { "csp": null } },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": ["icons/icon.ico"],
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "wix": {
        "fragmentPaths": ["wix/service.wxs"],
        "componentRefs": ["GalleriadService"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACED_AT_BUILD_TIME",
      "endpoints": ["http://127.0.0.1:8765/latest.json"],
      "dangerousInsecureTransportProtocol": true,
      "windows": { "installMode": "quiet" }
    }
  }
}
